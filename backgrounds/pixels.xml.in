<?xml version="1.0"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<wallpapers>
  <wallpaper deleted="false">
    <name>Pixels</name>
    <!-- points at the timeline, not an image; a timed wallpaper has no
         <thumbnail> sidecar, so pcolor/scolor stand in for the preview. -->
    <filename>@BACKGROUNDDIR@/pixels-timed.xml</filename>
    <options>zoom</options>
    <shade_type>solid</shade_type>
    <pcolor>#3465A4</pcolor>
    <scolor>#3465A4</scolor>
  </wallpaper>
</wallpapers>
