    <name>Balls</name>
    <filename>@BACKGROUNDDIR@/balls-l.jxl</filename>
    <filename-dark>@BACKGROUNDDIR@/balls-d.jxl</filename-dark>
    <options>zoom</options>
    <shade_type>solid</shade_type>
