<?xml version="1.0"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<wallpapers>
  <wallpaper deleted="false">
    <name>Dithered Sun</name>
    <filename>@BACKGROUNDDIR@/dithered-sun-l.jxl</filename>
    <filename-dark>@BACKGROUNDDIR@/dithered-sun-d.jxl</filename-dark>
    <options>zoom</options>
    <shade_type>solid</shade_type>
    <pcolor>#CCFCAF</pcolor>
    <scolor>#7BDECB</scolor>
  </wallpaper>
</wallpapers>
