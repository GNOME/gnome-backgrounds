<?xml version="1.0"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<wallpapers>
  <wallpaper deleted="false">
    <name>LCD Rainbow</name>
    <filename>@BACKGROUNDDIR@/lcd-rainbow-l.jxl</filename>
    <filename-dark>@BACKGROUNDDIR@/lcd-rainbow-d.jxl</filename-dark>
    <options>zoom</options>
    <shade_type>solid</shade_type>
    <pcolor>#DBDBDB</pcolor>
    <scolor>#E5E5E5</scolor>
  </wallpaper>
</wallpapers>
